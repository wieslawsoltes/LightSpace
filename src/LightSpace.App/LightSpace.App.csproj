<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(LightSpaceDesktopOnly)' == 'true'">net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType><UnoSingleProject>true</UnoSingleProject><UnoFeatures>SkiaRenderer;</UnoFeatures>
    <ApplicationTitle>LightSpace</ApplicationTitle><ApplicationId>io.github.wieslawsoltes.lightspace</ApplicationId>
    <ApplicationDisplayVersion>0.4.1</ApplicationDisplayVersion><ApplicationVersion>6</ApplicationVersion><ApplicationPublisher>LightSpace contributors</ApplicationPublisher>
    <Description>Local-first non-destructive photo editing with Uno Platform.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><IsPackable>false</IsPackable>
    <RunAOTCompilation>false</RunAOTCompilation><WasmShellGenerateAOTProfile>false</WasmShellGenerateAOTProfile>
    <WasmEnableThreads>false</WasmEnableThreads><WasmShellEnableThreads>false</WasmShellEnableThreads>
    <WasmEmitSymbolMap>true</WasmEmitSymbolMap>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../LightSpace.Workbench/LightSpace.Workbench.csproj"/><EmbeddedResource Include="Assets/Samples/*.jpg" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/*.js" />
  </ItemGroup>
</Project>
